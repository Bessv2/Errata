[gd_resource type="Resource" script_class="StyleBoard" format=3]

; Style-test board. Candidate art lives in assets/art/style_test/candidates/<slot>/
; and is NOT used by the game until Geordon approves it.
; PixelLab candidates come first in each slot; Kenney/code placeholders last.

